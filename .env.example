# Copy file này thành `.env` rồi điền key thật.
# File .env.example NÀY SẼ ĐƯỢC COMMIT — tuyệt đối không điền key thật vào đây.
# Lấy key miễn phí tại: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Các giá trị dưới đây đã được xác minh bằng lệnh gọi thật, để trống cũng được
# vì code đã đặt sẵn đúng những giá trị này làm mặc định.

# Hạn mức free tier đo được:
#   gemini-flash-lite-latest  -> còn dùng được, đặt làm mặc định
#   gemini-flash-latest       -> 20 request rồi hết hạn mức, dùng làm dự phòng
#   gemini-2.0-flash(-lite)   -> limit 0, free tier không được dùng
#   gemini-2.5-flash(-lite)   -> 404 với tài khoản mới
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_CHAT_MODEL_FALLBACK=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Nơi chạy embedding -----------------------------------------------------
#   local  : chạy trên máy bằng sentence-transformers. KHÔNG hạn mức, không cần
#            key. Cần cài thêm torch + sentence-transformers (~1,5 GB).
#   gemini : gọi API. Chất lượng tốt nhưng hạn mức free tier là 1.000 request
#            mỗi NGÀY, tính theo TÀI KHOẢN Google chứ không theo project — tạo
#            project mới rồi lấy key mới KHÔNG cho thêm hạn mức.
#
# Lưu ý: hết hạn mức không chỉ chặn việc NẠP dữ liệu mà chặn cả việc HỎI, vì mỗi
# câu hỏi cũng phải embed. Knowledge base vài nghìn chunk thì nên dùng `local`.
EMBED_BACKEND=local

# Đa ngữ, có tiếng Việt. Đừng dùng all-MiniLM-L6-v2 dù nó phổ biến trong các demo
# LangChain — model đó gần như thuần tiếng Anh.
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
LOCAL_EMBED_DEVICE=cpu

# PHẢI khớp với init.sql. store.assert_schema_matches() sẽ hỏng ngay nếu lệch.
#   768  cho intfloat/multilingual-e5-base (EMBED_BACKEND=local)
#   1536 cho gemini-embedding-001 (đã rút từ 3072 vì pgvector chỉ đánh index
#        được tối đa 2000 chiều)
# Đổi con số này thì phải dựng lại volume: docker compose down -v && up -d
EMBED_DIMENSION=768

# Cổng 5433 để không đụng PostgreSQL 5432 của dự án CRM
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/chatbot_rag

# Đo bằng 03_eval_retrieval.py + 08_eval_answers.py (không chép từ tutorial).
# Hạ từ 0.66 xuống 0.60 sau Milestone 6: khi đã có đủ 5 lớp chống hallucination
# thì ngưỡng không còn phải gánh một mình, hạ xuống lấy lại 2 câu bị từ chối oan
# mà vẫn 0/6 câu ngoài phạm vi bị bịa.
SIMILARITY_THRESHOLD=0.60

# Lớp 5 — vòng kiểm chứng entailment bằng LLM. auto = chỉ chạy khi lớp 3-4 (miễn
# phí) đã thấy dấu hiệu khả nghi, để không đốt hạn mức cho mọi câu.
#   auto | on | off
ENTAILMENT_CHECK=auto

# GraphRAG — mở rộng truy hồi bằng quan hệ giữa thực thể, chỉ với câu hỏi so sánh.
GRAPH_EXPANSION=on
GRAPH_MAX_EXTRA_CHUNKS=2
